menu "IPP Client"

    config IPP_PRINTER_HOST
        string "Drucker IP / Hostname"
        default "192.168.0.20"

    config IPP_PRINTER_PORT
        int "IPP Port"
        default 631
        range 1 65535

    config IPP_PRINTER_PATH
        string "IPP Pfad"
        default "/ipp/print"
        help
            Bei Canon Selphy meist /ipp/print. Falls der Drucker
            nicht antwortet, Pfad per "ipptool"/Avahi pruefen.

    config IPP_MEDIA
        string "Papierformat (IPP media keyword)"
        default ""
        help
            Leer lassen = Drucker-Standard. Gueltige Werte zeigt
            "media-supported" in der Ausgabe von ipp_get_printer_attributes().

endmenu
